import fs from 'fs';
import path from 'path';

import { reactRouter } from '@react-router/dev/vite';
import { sentryVitePlugin } from '@sentry/vite-plugin';
import tailwindcss from '@tailwindcss/vite';
import { visualizer } from 'rollup-plugin-visualizer';
import { defineConfig, loadEnv, type Plugin } from 'vite';
import tsconfigPaths from 'vite-tsconfig-paths';

/** @refinedev/react-table 等包声明了 sourceMappingURL 但未发布 .map 文件 */
function stripMissingSourceMapRefs(): Plugin {
  return {
    name: 'strip-missing-sourcemap-refs',
    enforce: 'pre',
    load(id) {
      if (!id.includes('node_modules') || !/\.(?:mjs|cjs|js)$/.test(id)) return null;

      const code = fs.readFileSync(id, 'utf-8');
      const match = code.match(/\/\/# sourceMappingURL=(.+)$/m);
      if (!match) return null;

      const mapPath = path.resolve(path.dirname(id), match[1].trim());
      if (fs.existsSync(mapPath)) return null;

      return code.replace(/\/\/# sourceMappingURL=.+$/m, '');
    },
  };
}

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, process.cwd(), '');

  return {
    define: {
      'import.meta.env.npm_package_version': JSON.stringify(process.env.npm_package_version),
    },
    server: {
      port: Number(env.VITE_CLIENT_PORT),
      strictPort: true,
      host: '0.0.0.0',

      // 可选配置: 本地使用自定义 https 域名
      // https: {
      //   key: fs.readFileSync('./me.ly.com+3-key.pem'),
      //   cert: fs.readFileSync('./me.ly.com+3.pem'),
      // },
      // proxy: {
      //   '/*': {
      //     target: `https://me.ly.com:5173`,
      //     secure: false,
      //     changeOrigin: true,
      //     headers: {
      //       'X-Forwarded-Proto': 'https',
      //     },
      //   },
      // },
    },
    plugins: [
      stripMissingSourceMapRefs(),
      tailwindcss(),
      reactRouter(),
      tsconfigPaths(),
      visualizer({ emitFile: true }), // 生成构建产物的可视化分析报告 stats.html

      // sentryVitePlugin({
      //   debug: false,
      //   org: env.SENTRY_ORG,
      //   project: env.SENTRY_PROJECT,
      //   authToken: env.SENTRY_AUTH_TOKEN,
      //   url: env.SENTRY_URL,
      //   sourcemaps: {
      //     filesToDeleteAfterUpload: ['**/*.map'],
      //   },
      //   release: {
      //     name: 'refine@' + process.env.npm_package_version,
      //     uploadLegacySourcemaps: {
      //       paths: ['.'],
      //     },
      //   },
      // }),
    ],
    resolve: {
      alias: {
        '@': path.resolve(__dirname, './app'),
        lodash: 'lodash-es',
      },
    },
    ssr: {
      noExternal: ['@refinedev/react-table', 'lodash', 'lodash-es'],
    },
    build: {
      sourcemap: false,
      // Rollup 报告 "use client" 指令时若无法解析 sourcemap 位置，会输出误导性 meta 告警
      rollupOptions: {
        onwarn(warning, warn) {
          if (warning.message?.includes('Error when using sourcemap for reporting an error')) {
            return;
          }
          warn(warning);
        },
      },
      // pdf-renderer 为弹窗内 lazy 加载的 demo chunk，@react-pdf/renderer 压缩后约 1.5MB 属正常体积
      chunkSizeWarningLimit: 1600,
    },
  };
});
